<launch>
    <node pkg="dev_rosa" exec="rosa_exec" name="rosa_node" output="screen">
        <!-- ROS2 ROSA NODE -->
        <param name="num_scans" type="int" value="1"/> <!-- Number of Lidar scans before publishing -->

        <!-- ROSA MAIN -->
        <param name="max_lidar_dist" type="float" value="20"/> <!-- Max distance (radius) for lidar points used for calculations -->
        <param name="max_pts" type="int" value="250"/> <!-- Max number of points in downsampled cloud -->
        <param name="min_pts" type="int" value="100"/> <!-- Min number of points in downsampled cloud (For reliable computation) -->

        <param name="normal_est_KNN" type="int" value="10"/> <!-- K nearest neighbours for normal estimation -->
        <param name="neighbour_radius" type="float" value="0.05"/> <!-- radius for mahalanobis neighbour search -->
        <param name="neighbour_KNN" type="int" value="6"/> <!-- K nearest surface neigbours -->

        <param name="drosa_iter" type="int" value="3"/> <!-- Number of iterations for calculating ROSA points orientation and position -->
        <param name="dcrosa_iter" type="int" value="2"/> <!-- Number of iterations for smoothing and shrinkign ROSA points -->

        <param name="sample_radius" type="float" value="0.05"/> <!-- Sampling radius for ROSA points selection -->
        <param name="alpha" type="float" value="0.3"/> <!-- Scalefactor for recentering to fuse euclidian and projection -->
        
        <!-- Global Skeleton Vertex Fusion - After Scale Restoration -->
        <param name="kf_dist_th" type="float" value="1.0"/> <!-- Distance threshold for new vertex increment -->
        <param name="kf_conf_th" type="float" value="0.5"/> <!-- Confidence threshold for valid vertex -->

        <param name="kf_process_noise" type="float" value="0.0001"/> <!-- Kalman Filter Process Noise -->
        <param name="kf_meas_noise" type="float" value="0.1"/> <!-- Kalman Filter Measurement Noise -->

        <!-- Global Skeleton (not used atm) -->
        <param name="tolerance" type="float" value="5.0"/> <!-- Radius for global skeleton increment - Space between vertices -->
    </node>
</launch>
